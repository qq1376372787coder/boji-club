# Normalise line endings so the same bytes are checked out everywhere.
#
# Without this file the Windows working tree carried CRLF for part of the
# tree while the committed blobs were LF. A SHA-256 manifest generated on
# Windows therefore did not match the committed content on the macOS / Linux
# CI runners, and `shasum -a 256 -c SOURCE-MANIFEST.sha256` failed there for
# every CRLF file. Pinning the line endings keeps the working tree, the
# committed blobs and the manifest in agreement on every platform.
* text=auto eol=lf

# Sources, scripts and data that must never be CRLF.
*.sh text eol=lf
*.bash text eol=lf
*.swift text eol=lf
*.pbxproj text eol=lf
*.xcscheme text eol=lf
*.xctestplan text eol=lf
*.xcprivacy text eol=lf
*.entitlements text eol=lf
*.php text eol=lf
*.py text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.plist text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.txt text eol=lf
*.log text eol=lf
*.sha256 text eol=lf
*.svg text eol=lf
*.html text eol=lf

# Binary assets are never touched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp4 binary
*.mov binary
*.m4a binary
*.mp3 binary
*.wav binary
*.caf binary
*.pdf binary
*.zip binary
*.ttf binary
*.otf binary
