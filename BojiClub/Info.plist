<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BojiAPNSEnvironment</key>
	<string>$(BOJI_APNS_ENVIRONMENT)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>薄肌俱乐部</string>
	<key>RevenueCatPublicSDKKey</key>
	<string>$(REVENUECAT_PUBLIC_SDK_KEY)</string>
	<key>RevenueCatMonthlyProductID</key>
	<string>yuefu</string>
	<key>RevenueCatLifetimeProductID</key>
	<string>yongjiu</string>
	<key>RevenueCatAnnualProductID</key>
	<string>nianfu</string>
	<key>RevenueCatMemberEntitlementID</key>
	<string>薄肌俱乐部_pro</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- 应用只走系统标准 HTTPS/TLS，不含自制加密；TestFlight 分发需要这个声明。 -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>BojiLaunchMark</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>把你说的餐食转成文字，方便补记饮食；录音不保存、不上传。</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>仅使用手机本地识别把餐食语音转为文字；不支持时可直接打字。</string>
	<key>NSCameraUsageDescription</key>
	<string>拍摄你主动选择发送的照片，或用于饮食记录和自愿的身体复盘；发送或保存前会由你核对。</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>选择你主动提供的照片，用于 AI 对话、饮食记录或自愿的身体复盘。</string>
	<key>NSHealthShareUsageDescription</key>
	<string>读取你允许共享的身体测量、步数、活动能量、心率、睡眠和运动记录，用于身体与训练看板；你按天确认分享后才会保存云端并用于 AI 日报。</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>仅在你开启并逐次确认后，将已保存训练的开始和结束时间写入 Apple 健康；不会伪造热量、心率或组次。</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.bojiclub.training</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>bojiclub</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
