[Unit]
Description=Boji Club account deletion cleanup
After=network.target mariadb.service bojiclub-ai.service

[Service]
Type=oneshot
User=www-data
Group=www-data
ExecStart=/usr/bin/php /opt/bojiclub-account/process-deletions.php
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/bojiclub-account/media

