[Unit]
Description=Boji Club AI run event retention
After=network.target
ConditionPathExists=/opt/bojiclub-account/config.php

[Service]
Type=oneshot
User=www-data
Group=www-data
ExecStart=/usr/bin/php /opt/bojiclub-account/prune-ai-runs.php 30 500
TimeoutStartSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
