[Unit]
Description=Boji Club automatic daily/weekly analysis dispatcher
After=network.target mariadb.service bojiclub-ai.service
ConditionPathExists=/opt/bojiclub-account/config.php

[Service]
Type=oneshot
User=www-data
Group=www-data
ExecStart=/usr/bin/php /opt/bojiclub-account/process-club-automation.php
TimeoutStartSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/bojiclub-account/media
