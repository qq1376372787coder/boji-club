[Unit]
Description=Boji Club proactive push dispatcher
After=network.target mariadb.service
ConditionPathExists=/opt/bojiclub-account/config.php

[Service]
Type=oneshot
User=nginx
Group=nginx
EnvironmentFile=/etc/bojiclub/push-activation.env
ExecStart=/usr/bin/php /opt/bojiclub-account/process-club-push.php
TimeoutStartSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/bojiclub-account/private-cache
