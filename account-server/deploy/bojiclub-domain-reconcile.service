[Unit]
Description=Boji Club Domain Projection Reconciler
After=network.target mariadb.service
ConditionPathExists=/opt/bojiclub-account/config.php

[Service]
Type=oneshot
User=www-data
Group=www-data
ExecStart=/usr/bin/php /opt/bojiclub-account/reconcile-domain-outbox.php
TimeoutStartSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
