[Unit]
Description=Boji Club membership reconciliation (RevenueCat refresh)
After=network.target
ConditionPathExists=/opt/bojiclub-account/config.php

[Service]
Type=oneshot
User=www-data
Group=www-data
ExecStart=/usr/bin/php /opt/bojiclub-account/process-membership-refresh.php 20
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
