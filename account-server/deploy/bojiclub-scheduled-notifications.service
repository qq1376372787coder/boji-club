[Unit]
Description=Boji Club scheduled user notifications
After=network-online.target mariadb.service
[Service]
Type=oneshot
User=nginx
Group=nginx
WorkingDirectory=/opt/bojiclub-account
ExecStart=/usr/bin/php /opt/bojiclub-account/process-scheduled-notifications.php
TimeoutStartSec=360
NoNewPrivileges=true
PrivateTmp=true
