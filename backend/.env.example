# 在云 Mac 运行 python3 setup.py 配置，不要把真实密钥写入源码。
MINIMAX_API_KEY=
DEEPSEEK_API_KEY=
# Web admin may change only these documented provider controls. API endpoints and model IDs are fixed in source.
MINIMAX_ENABLED=1
MINIMAX_PRIORITY=20
DEEPSEEK_ENABLED=1
DEEPSEEK_PRIORITY=10
APP_TOKEN=
SESSION_SIGNING_KEY=
PORT=8787
# Legacy MAX_JOBS_PER_DAY is replaced by persistent admin capacity settings.
# Fresh install: global daily success limit 0, per-account daily success limit 0 (unlimited); pending limit 800.
# Failures and retries never charge extra; first successful task completion charges one.
# Legacy account config ai_daily_limit is ignored; edit all quotas in the admin AI capacity form.
# Actual concurrency is persistent admin worker_limit, 1..32 (fresh install 3).
# Read this server's current persistent values in the admin; its AI MemoryMax remains 512M.
